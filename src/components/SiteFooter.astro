---
import { Compass, ArrowUpRight, Rss } from "@lucide/astro";
import { SITE } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer border-t border-line bg-cream">
  <div class="max-w-6xl mx-auto px-5 md:px-8 py-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <a href="/" class="flex items-center gap-2.5 group">
        <span
          class="grid place-items-center w-9 h-9 rounded-xl shadow-card ring-1 ring-black/10 dark:ring-white/15 group-hover:scale-105 transition-transform"
          style="background: linear-gradient(135deg, #ff9933 0%, #ffffff 50%, #138808 100%);"
        >
          <Compass size={18} stroke-width={2.4} class="text-navy-800" />
        </span>
        <span class="flex flex-col leading-none">
          <span class="font-display font-bold text-lg text-ink tracking-tight">
            {SITE.title}
          </span>
          <span class="text-[11px] font-medium text-fog tracking-wide">
            {SITE.tagline}
          </span>
        </span>
      </a>

      <nav class="flex items-center gap-5 text-sm font-medium text-fog" aria-label="Footer">
        <a href="/about" class="hover:text-ink transition-colors">About</a>
        <a
          href="/rss.xml"
          class="inline-flex items-center gap-1 hover:text-ink transition-colors"
        >
          <Rss size={14} /> RSS
        </a>
        <a
          href="https://blog.anindyadey.com"
          class="inline-flex items-center gap-1 hover:text-ink transition-colors"
        >
          Blog <ArrowUpRight size={14} />
        </a>
      </nav>
    </div>

    <div
      class="mt-8 pt-6 border-t border-line space-y-2.5 text-xs leading-relaxed text-fog"
    >
      <p>© {year} {SITE.author}. All rights reserved.</p>
      <p>
        An independent, personal project. Figures are sourced and dated on each
        page; nothing here is official or endorsed by any government body.
      </p>
      <p>
        Press
        <kbd
          class="font-mono px-1.5 py-0.5 rounded bg-paper-2 border border-line text-ink/80"
          >⌘K</kbd
        >
        (or <kbd
          class="font-mono px-1.5 py-0.5 rounded bg-paper-2 border border-line text-ink/80"
          >Ctrl K</kbd
        >) anywhere to search.
      </p>
    </div>
  </div>
</footer>
