---
import { getCollection } from "astro:content";

const ideas = await getCollection("ideas");
const vizs = await getCollection("now");

const ideaItems = ideas.map((i) => ({
  section: "Next — ideas",
  title: i.data.title,
  href: `/next/${i.id}`,
}));

const vizItems = vizs.map((v) => ({
  section: "Now — data stories",
  title: v.data.title,
  href: `/now/${v.id}`,
}));

const staticItems = [
  { section: "Sections", title: "Then — the timeline", href: "/then" },
  { section: "Sections", title: "Now — where we stand", href: "/now" },
  { section: "Sections", title: "Next — ideas", href: "/next" },
  { section: "Sections", title: "About — method & sources", href: "/about" },
  { section: "Sections", title: "Schemes — every scheme referenced", href: "/schemes" },
  { section: "Sections", title: "Search", href: "/search" },
];

const items = JSON.stringify([...staticItems, ...vizItems, ...ideaItems]);
---

<div id="cmdk-root" hidden>
  <div
    id="cmdk-backdrop"
    class="fixed inset-0 z-50 bg-ink/40 backdrop-blur-sm"
    data-close
  >
  </div>
  <div
    class="fixed z-50 top-[12vh] left-1/2 -translate-x-1/2 w-[92vw] max-w-xl rounded-2xl bg-paper border border-line shadow-lift overflow-hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Command palette"
  >
    <input
      id="cmdk-input"
      type="text"
      placeholder="Search the journal…"
      autocomplete="off"
      class="w-full px-5 py-4 text-base bg-transparent border-b border-line outline-none placeholder:text-fog"
    />
    <ul id="cmdk-list" class="max-h-[50vh] overflow-y-auto py-2"></ul>
    <div
      class="px-4 py-2.5 border-t border-line text-[11px] text-fog flex flex-wrap items-center gap-x-4 gap-y-1"
    >
      <span class="inline-flex items-center gap-1"
        ><kbd class="font-mono">⌘K</kbd> toggle</span
      >
      <span class="inline-flex items-center gap-1"
        ><kbd class="font-mono">↑↓</kbd> navigate</span
      >
      <span class="inline-flex items-center gap-1"
        ><kbd class="font-mono">↵</kbd> open</span
      >
      <span class="inline-flex items-center gap-1"
        ><kbd class="font-mono">esc</kbd> close</span
      >
    </div>
  </div>
</div>

<script>
  const DATA: { section: string; title: string; href: string }[] = JSON.parse(
    (
      document.getElementById("cmdk-items-data") as HTMLScriptElement
    )?.textContent ?? "[]",
  );

  const root = document.getElementById("cmdk-root");
  const input = document.getElementById("cmdk-input") as HTMLInputElement;
  const list = document.getElementById("cmdk-list")!;
  let active = 0;
  let filtered: typeof DATA = DATA;

  function itemHtml(item: typeof DATA[0], i: number) {
    return (
      '<li class="px-4 py-2.5 cursor-pointer flex items-baseline justify-between gap-3 ' +
      (i === active ? "bg-cream text-ink" : "text-ink-soft hover:bg-cream/60") +
      '" data-idx="' +
      i +
      '">' +
      '<span class="text-sm font-medium">' +
      item.title +
      "</span>" +
      '<span class="text-[11px] text-fog">' +
      item.section +
      "</span></li>"
    );
  }

  function render() {
    if (filtered.length === 0) {
      list.innerHTML =
        '<li class="px-4 py-3 text-sm text-fog">No results — try another word.</li>';
      return;
    }
    list.innerHTML = filtered.map(itemHtml).join("");
    [...list.children].forEach((li) => {
      li.addEventListener("click", () => {
        const idx = Number((li as HTMLElement).dataset.idx);
        go(filtered[idx]);
      });
      li.addEventListener("mousemove", () => {
        const idx = Number((li as HTMLElement).dataset.idx);
        if (active !== idx) {
          active = idx;
          paint();
        }
      });
    });
  }

  function paint() {
    [...list.querySelectorAll("li[data-idx]")].forEach((li) => {
      const i = Number((li as HTMLElement).dataset.idx);
      li.className =
        "px-4 py-2.5 cursor-pointer flex items-baseline justify-between gap-3 " +
        (i === active ? "bg-cream text-ink" : "text-ink-soft hover:bg-cream/60");
    });
  }

  function go(item: typeof DATA[0]) {
    close();
    window.location.href = item.href;
  }

  function open() {
    root?.removeAttribute("hidden");
    input.value = "";
    filtered = DATA;
    active = 0;
    render();
    requestAnimationFrame(() => {
      input.focus();
      input.select();
    });
  }

  function close() {
    root?.setAttribute("hidden", "");
  }

  function toggle() {
    if (root?.hasAttribute("hidden")) open();
    else close();
  }

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      toggle();
    } else if (e.key === "Escape" && !root?.hasAttribute("hidden")) {
      close();
    } else if (!root?.hasAttribute("hidden")) {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        active = Math.min(active + 1, filtered.length - 1);
        paint();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        active = Math.max(active - 1, 0);
        paint();
      } else if (e.key === "Enter" && filtered[active]) {
        go(filtered[active]);
      }
    }
  });

  input.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    filtered = q
      ? DATA.filter(
          (d) =>
            d.title.toLowerCase().includes(q) ||
            d.section.toLowerCase().includes(q),
        )
      : DATA;
    active = 0;
    render();
  });

  document.getElementById("cmdk-backdrop")?.addEventListener("click", close);

  const openBtn = document.getElementById("palette-open");
  openBtn?.addEventListener("click", open);
</script>

<script id="cmdk-items-data" type="application/json" set:html={items} />
