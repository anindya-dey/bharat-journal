---
import { BookOpen, ExternalLink } from "@lucide/astro";

interface Props {
  sources: { name: string; url: string; retrieved: string; note?: string }[];
}

const { sources } = Astro.props;
---

<aside class="mt-10 rounded-2xl border border-line bg-cream p-6">
  <h3
    class="flex items-center gap-2 font-display font-bold text-sm uppercase tracking-wide text-ink mb-4"
  >
    <BookOpen size={16} stroke-width={2.4} />
    Sources
  </h3>
  <ul class="space-y-3">
    {
      sources.map((source) => (
        <li class="text-sm">
          <a
            href={source.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-start gap-1.5 font-medium text-navy hover:text-saffron transition-colors"
          >
            <span class="underline decoration-line underline-offset-2">
              {source.name}
            </span>
            <ExternalLink size={13} class="mt-0.5 shrink-0" />
          </a>
          <span class="text-fog"> · data as of {source.retrieved}</span>
          {source.note && (
            <span class="block text-xs text-fog mt-0.5">{source.note}</span>
          )}
        </li>
      ))
    }
  </ul>
</aside>
