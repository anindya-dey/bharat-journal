---
interface Props {
  caption?: string;
  subCaption?: string;
}

const { caption, subCaption } = Astro.props;
---

<figure class="my-8">
  <div class="rounded-2xl border border-line bg-paper-2 p-4 md:p-6 shadow-card">
    <slot />
  </div>
  {
    (caption || subCaption) && (
      <figcaption class="mt-3 text-sm leading-relaxed text-fog">
        {caption && <span class="font-semibold text-ink">{caption}</span>}
        {caption && subCaption && " — "}
        {subCaption}
      </figcaption>
    )
  }
</figure>
