---
import * as Plot from "@observablehq/plot";
import { parseHTML } from "linkedom";

interface Datum {
  date: string;
  value: number;
}

interface Props {
  data: Datum[];
  yLabel?: string;
  annotations?: { date: string; label: string }[];
  color?: string;
  seriesLabel?: string;
  formatValue?: (v: number) => string;
}

const {
  data,
  yLabel = "",
  annotations = [],
  color = "#1d3557",
  seriesLabel = yLabel,
  formatValue,
} = Astro.props;

// Observable Plot needs a DOM; Astro components run in Node.
const linkedom = parseHTML("<!doctype html><html><body></body></html>");
const g = globalThis as any;
const priorDocument = g.document;
const priorWindow = g.window;
g.document = linkedom.document;
g.window = {
  document: linkedom.document,
  navigator: { userAgent: "node" },
  screen: { width: 860, height: 400 },
  devicePixelRatio: 1,
  HTMLElement: linkedom.HTMLElement,
  SVGElement: linkedom.SVGElement,
};

const W = 860;
const H = 400;
const yMax = Math.max(...data.map((d) => d.value)) * 1.12;
const gradId = `grad-${Math.random().toString(36).slice(2, 8)}`;

const svg = Plot.plot({
  width: W,
  height: H,
  marginTop: 24,
  marginBottom: 36,
  marginLeft: 64,
  marginRight: 48,
  style: {
    background: "transparent",
    fontFamily: "Quicksand Variable, sans-serif",
    fontSize: "12px",
    overflow: "visible",
    color: "#5d6472",
  },
  y: {
    domain: [0, yMax],
    label: yLabel,
    labelOffset: 44,
    grid: true,
    ticks: 5,
    tickFormat: (v: number) =>
      v >= 1000 ? `${(v / 1000).toFixed(v >= 10000 ? 0 : 1)}k` : `${v}`,
  },
  x: {
    type: "time",
    label: null,
    ticks: 7,
    tickFormat: "%Y",
  },
  marks: [
    Plot.areaY(data, {
      x: "date",
      y: "value",
      curve: "monotone-x",
      fill: `url(#${gradId})`,
    }),
    Plot.lineY(data, {
      x: "date",
      y: "value",
      curve: "monotone-x",
      stroke: color,
      strokeWidth: 2.5,
      strokeLinejoin: "round",
    }),
    Plot.dot(data, {
      x: "date",
      y: "value",
      fill: color,
      r: 3.5,
      stroke: "#faf9f6",
      strokeWidth: 2,
    }),
    ...(annotations.length
      ? [
          Plot.ruleX(annotations, {
            x: "date",
            stroke: "#d97706",
            strokeWidth: 1,
            strokeDasharray: "4 4",
            opacity: 0.7,
          }),
          Plot.text(annotations, {
            x: "date",
            y: yMax,
            text: "label",
            fontSize: 10,
            fontWeight: 600,
            fill: "#b45309",
            textAnchor: "start",
            dx: 4,
            dy: -8,
          }),
        ]
      : []),
  ],
});

// Last-point value bubble

g.document = priorDocument;
g.window = priorWindow;

const fmt =
  formatValue ??
  ((v: number) => (v >= 1000 ? `${(v / 1000).toFixed(1)}k` : `${v}`));

const defs = `<defs><linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${color}" stop-opacity="0.30"/><stop offset="100%" stop-color="${color}" stop-opacity="0.02"/></linearGradient></defs>`;

let svgStr = (svg as any).outerHTML as string;
svgStr = svgStr.replace(/<svg[^>]*>/, (tag) => {
  const aria = `<title>${seriesLabel || "Chart"}</title>`;
  const withDefs = tag + aria + defs;
  return withDefs
    .replace(/\swidth="[^"]*"/, ' width="100%"')
    .replace(/\sheight="[^"]*"/, ' height="auto"')
    .replace(/<svg/, `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet"`);
});

const summary = data
  .map((d) => `${d.date.slice(0, 4)}: ${fmt(d.value)}`)
  .join("; ");
---

<div class="chart-svg w-full">
  <span class="sr-only">
    {seriesLabel || "Chart"}: {summary}
  </span>
  <Fragment set:html={svgStr} />
</div>
