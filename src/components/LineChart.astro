---
import * as Plot from "@observablehq/plot";
import { parseHTML } from "linkedom";

interface Datum {
  date: string;
  value: number;
}

interface Props {
  data: Datum[];
  yLabel?: string;
  annotations?: { date: string; label: string }[];
  color?: string;
  seriesLabel?: string;
  formatValue?: (v: number) => string;
  formatLabel?: (d: Datum) => string;
}

const {
  data,
  yLabel = "",
  annotations = [],
  color = "#ea580c",
  seriesLabel = yLabel,
  formatValue,
  formatLabel,
} = Astro.props;

// Sort ascending so ticks, line order and the end-point all agree.
const sorted = [...data].sort((a, b) =>
  String(a.date).localeCompare(String(b.date)),
);

// Put an x-axis tick on actual data points (not arbitrary "nice" years) so
// every point — and the hover guide line — lines up with a labelled tick.
// Space the labels by *time*, not by index, and thin only when a series is
// too dense: that keeps yearly clusters (e.g. 2002–2024) from crowding the
// axis while sparse early decades still get their own label.
const MAX_TICKS = 12;
const times = sorted.map((d) => new Date(d.date).getTime());
const span = times[times.length - 1] - times[0];
const minGap = span > 0 ? span / MAX_TICKS : 0;
const tickIdx: number[] = [0];
for (let i = 1; i < sorted.length; i++) {
  if (times[i] - times[tickIdx[tickIdx.length - 1]] >= minGap) tickIdx.push(i);
}
const lastIdx = sorted.length - 1;
if (tickIdx[tickIdx.length - 1] !== lastIdx) {
  if (times[lastIdx] - times[tickIdx[tickIdx.length - 1]] < minGap) {
    tickIdx[tickIdx.length - 1] = lastIdx;
  } else {
    tickIdx.push(lastIdx);
  }
}
const xTicks = tickIdx.map((i) => new Date(sorted[i].date));

const num = (v: number) =>
  (Math.round(v * 100) / 100).toLocaleString("en-IN", {
    maximumFractionDigits: 2,
  });
const fmt =
  formatValue ?? ((v: number) => (v >= 1000 ? `${num(v / 1000)}k` : num(v)));
const labelFmt = formatLabel ?? ((d: Datum) => d.date.slice(0, 4));

const linkedom = parseHTML("<!doctype html><html><body></body></html>");
const g = globalThis as any;
const priorDocument = g.document;
const priorWindow = g.window;
g.document = linkedom.document;
g.window = {
  document: linkedom.document,
  navigator: { userAgent: "node" },
  screen: { width: 860, height: 400 },
  devicePixelRatio: 1,
  HTMLElement: linkedom.HTMLElement,
  SVGElement: linkedom.SVGElement,
};

const W = 860;
const H = 400;
const PAD_L = 64;
const PAD_R = 28;
const PAD_T = 24;
const PAD_B = 36;
const yMax = Math.max(...sorted.map((d) => d.value)) * 1.12;
const gradId = `grad-${Math.random().toString(36).slice(2, 8)}`;

const svg = Plot.plot({
  width: W,
  height: H,
  marginTop: PAD_T,
  marginBottom: PAD_B,
  marginLeft: PAD_L,
  marginRight: PAD_R,
  style: {
    background: "transparent",
    fontFamily: "Quicksand Variable, sans-serif",
    fontSize: "12px",
    overflow: "visible",
    color: "var(--color-fog)",
  },
  y: {
    domain: [0, yMax],
    label: yLabel,
    labelOffset: 44,
    grid: true,
    ticks: 5,
    tickFormat: (v: number) =>
      v >= 1000 ? `${(v / 1000).toFixed(v >= 10000 ? 0 : 1)}k` : `${v}`,
  },
  x: { type: "time", label: null, ticks: xTicks, tickFormat: "%Y" },
  marks: [
    Plot.areaY(sorted, {
      x: "date",
      y: "value",
      curve: "monotone-x",
      fill: `url(#${gradId})`,
    }),
    Plot.lineY(sorted, {
      x: "date",
      y: "value",
      curve: "monotone-x",
      stroke: color,
      strokeWidth: 2.5,
      strokeLinejoin: "round",
    }),
    Plot.dot(sorted, {
      x: "date",
      y: "value",
      r: 3,
      fill: color,
      stroke: "var(--color-paper)",
      strokeWidth: 1.5,
    }),
    ...(annotations.length
      ? [
          Plot.ruleX(annotations, {
            x: "date",
            stroke: "#c026d3",
            strokeWidth: 1,
            strokeDasharray: "4 4",
            opacity: 0.7,
          }),
          Plot.text(annotations, {
            x: "date",
            y: yMax,
            text: "label",
            fontSize: 10,
            fontWeight: 600,
            fill: "#b45309",
            textAnchor: "start",
            dx: 4,
            dy: -8,
          }),
        ]
      : []),
    // End-point value bubble
    Plot.dot([sorted[sorted.length - 1]], {
      x: "date",
      y: "value",
      r: 5,
      fill: color,
      stroke: "var(--color-paper)",
      strokeWidth: 2,
    }),
    Plot.text([sorted[sorted.length - 1]], {
      x: "date",
      y: "value",
      text: (d: Datum) => fmt(d.value),
      dx: 10,
      dy: -6,
      fontSize: 12,
      fontWeight: 700,
      fill: color,
      textAnchor: "start",
    }),
  ],
});

g.document = priorDocument;
g.window = priorWindow;


const defs = `<defs><linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${color}" stop-opacity="0.30"/><stop offset="100%" stop-color="${color}" stop-opacity="0.02"/></linearGradient></defs>`;

let svgStr = (svg as any).outerHTML as string;
svgStr = svgStr.replace(/<svg[^>]*>/, (tag) =>
  (tag + defs)
    .replace(/\swidth="[^"]*"/, ' width="100%"')
    .replace(/\sheight="[^"]*"/, ' height="auto"')
    .replace(
      /<svg/,
      `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="${seriesLabel || "Chart"}"`,
    ),
);

// Tooltip payload: label, value, normalized y fraction, and timestamp for x
const tipData = sorted.map((d) => ({
  label: labelFmt(d),
  value: fmt(d.value),
  f: yMax > 0 ? d.value / yMax : 0,
  t: new Date(d.date).getTime(),
}));
const summary = sorted.map((d) => `${labelFmt(d)}: ${fmt(d.value)}`).join("; ");
const jsonTips = JSON.stringify(tipData);
---

<div
  class="chart-svg w-full chart-hover relative"
  data-chart
  data-title={seriesLabel}
  data-color={color}
  data-tips={jsonTips}
  data-w={W}
  data-h={H}
  data-padl={PAD_L}
  data-padr={PAD_R}
  data-padt={PAD_T}
  data-padb={PAD_B}
>
  <span class="sr-only">{seriesLabel || "Chart"}: {summary}</span>
  <Fragment set:html={svgStr} />
  <div class="chart-tip"></div>
</div>
