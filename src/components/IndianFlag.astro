---
interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className = "" } = Astro.props;

const cx = 45;
const cy = 30;
const rInner = 1.6;
const rOuter = 5.2;
const spokes = Array.from({ length: 24 }, (_, i) => {
  const a = (i * 360) / 24;
  const rad = (a * Math.PI) / 180;
  return {
    x1: cx + rInner * Math.cos(rad),
    y1: cy + rInner * Math.sin(rad),
    x2: cx + rOuter * Math.cos(rad),
    y2: cy + rOuter * Math.sin(rad),
  };
});
---

<svg
  viewBox="0 0 90 60"
  width={size}
  height={(size * 2) / 3}
  class:list={["inline-block align-middle", className]}
  role="img"
  aria-label="Flag of India"
>
  <rect width="90" height="20" fill="#ff9933"></rect>
  <rect y="20" width="90" height="20" fill="#ffffff"></rect>
  <rect y="40" width="90" height="20" fill="#138808"></rect>
  <circle
    cx={cx}
    cy={cy}
    r="6"
    fill="none"
    stroke="#000080"
    stroke-width="1.1"></circle>
  {
    spokes.map((s) => (
      <line
        x1={s.x1}
        y1={s.y1}
        x2={s.x2}
        y2={s.y2}
        stroke="#000080"
        stroke-width="0.55"
      />
    ))
  }
  <circle cx={cx} cy={cy} r="1.3" fill="#000080"></circle>
  <rect
    width="90"
    height="60"
    fill="none"
    stroke="rgba(0,0,0,0.18)"
    stroke-width="1.5"></rect>
</svg>
