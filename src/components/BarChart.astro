---
import * as Plot from "@observablehq/plot";
import { parseHTML } from "linkedom";

interface Datum {
  label: string;
  value: number;
}

interface Props {
  data: Datum[];
  yLabel?: string;
  highlightLast?: boolean;
  color?: string;
  seriesLabel?: string;
  formatValue?: (d: Datum) => string;
}

const {
  data,
  yLabel = "",
  highlightLast = true,
  color = "#1d3557",
  seriesLabel = yLabel,
  formatValue,
} = Astro.props;

const linkedom = parseHTML("<!doctype html><html><body></body></html>");
const g = globalThis as any;
const priorDocument = g.document;
const priorWindow = g.window;
g.document = linkedom.document;
g.window = {
  document: linkedom.document,
  navigator: { userAgent: "node" },
  screen: { width: 860, height: 400 },
  devicePixelRatio: 1,
  HTMLElement: linkedom.HTMLElement,
  SVGElement: linkedom.SVGElement,
};

const W = 860;
const H = 400;
const yMax = Math.max(...data.map((d) => d.value)) * 1.12;
const num = (v: number) =>
  (Math.round(v * 100) / 100).toLocaleString("en-IN", {
    maximumFractionDigits: 2,
  });
const fmt = formatValue ?? ((d: Datum) => num(d.value));

const svg = Plot.plot({
  width: W,
  height: H,
  marginTop: 24,
  marginBottom: 36,
  marginLeft: 56,
  marginRight: 28,
  style: {
    background: "transparent",
    fontFamily: "Quicksand Variable, sans-serif",
    fontSize: "12px",
    overflow: "visible",
    color: "var(--color-fog)",
  },
  y: { domain: [0, yMax], label: yLabel, labelOffset: 42, grid: true, ticks: 5 },
  x: { type: "band", label: null },
  marks: [
    Plot.barY(data, {
      x: "label",
      y: "value",
      rx: 6,
      fill: (_d: Datum, i: number) =>
        highlightLast && i === data.length - 1 ? "#e07b1a" : color,
      fillOpacity: 0.92,
    }),
    Plot.text(data, {
      x: "label",
      y: "value",
      text: fmt,
      dy: -9,
      fontSize: 11,
      fontWeight: 600,
      fill: "var(--color-ink)",
    }),
  ],
});

g.document = priorDocument;
g.window = priorWindow;

let svgStr = (svg as any).outerHTML as string;
svgStr = svgStr.replace(/<svg[^>]*>/, (tag) =>
  tag
    .replace(/\swidth="[^"]*"/, ' width="100%"')
    .replace(/\sheight="[^"]*"/, ' height="auto"')
    .replace(
      /<svg/,
      `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="${seriesLabel || "Chart"}"`,
    ),
);

const summary = data.map((d) => `${d.label}: ${fmt(d)}`).join("; ");
const jsonTips = JSON.stringify(
  data.map((d) => ({
    label: d.label,
    value: fmt(d),
    f: yMax > 0 ? d.value / yMax : 0,
  })),
);
---

<div
  class="chart-svg w-full chart-hover relative"
  data-chart
  data-bar
  data-tips={jsonTips}
  data-w={W}
  data-h={H}
>
  <span class="sr-only">{seriesLabel || "Chart"}: {summary}</span>
  <Fragment set:html={svgStr} />
  <div
    class="chart-tip pointer-events-none absolute z-10 hidden rounded-xl bg-slate-900 text-slate-50 px-3 py-2 text-xs font-semibold shadow-lift backdrop-blur-sm"
  >
  </div>
</div>
