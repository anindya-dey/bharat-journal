---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import {
  Landmark,
  Wheat,
  Radio,
  ShieldCheck,
  Sprout,
  Factory,
  Atom,
  TrainFront,
  Users,
  HeartPulse,
  Milestone as MilestoneIcon,
  ArrowRight,
} from "@lucide/astro";
import { ERAS, SECTORS, MILESTONES } from "../data/milestones";

const ERA_ICONS: Record<string, any> = {
  "nation-building": Landmark,
  "food-and-industry": Wheat,
  liberalisation: Radio,
  "welfare-and-digital": ShieldCheck,
};

const SECTOR_ICONS: Record<string, any> = {
  agriculture: Sprout,
  industry: Factory,
  "science-tech": Atom,
  infrastructure: TrainFront,
  society: Users,
  health: HeartPulse,
};

const byEra = ERAS.map((era) => {
  const milestones = MILESTONES.filter((m) => m.era === era.id).sort(
    (a, b) => a.year - b.year,
  );
  const years = [...new Set(milestones.map((m) => m.year))].sort(
    (a, b) => a - b,
  );
  const yearGroups = years.map((year) => ({
    year,
    milestones: milestones.filter((m) => m.year === year),
  }));
  return { ...era, yearGroups, count: milestones.length };
});

const total = MILESTONES.length;

// ---- Density chart: milestones per year, 1947 → 2014 ----
const startYear = 1947;
const endYear = 2014;
const density = Array.from({ length: endYear - startYear + 1 }, (_, i) => {
  const year = startYear + i;
  return { year, count: MILESTONES.filter((m) => m.year === year).length };
});
const maxCount = Math.max(...density.map((d) => d.count), 1);
const DW = 900;
const DH = 110;
const padT = 10;
const padB = 6;
const n = density.length;
const band = DW / n;
const gap = 2;
const barW = band - gap;
const chartH = DH - padT - padB;
const bars = density.map((d, i) => {
  const h = (d.count / maxCount) * chartH;
  return {
    x: i * band + gap / 2,
    y: DH - padB - h,
    w: barW,
    h: Math.max(h, d.count > 0 ? 2 : 0),
    year: d.year,
    count: d.count,
  };
});
// era divider x-positions
const eraDividers = [1965, 1991, 2005].map((yr) => ({
  year: yr,
  x: (yr - startYear) * band,
}));
const axisTicks = [1947, 1960, 1980, 2000, 2014].map((yr) => ({
  year: yr,
  pct: (((yr - startYear) + 0.5) / n) * 100,
}));
const peakYears = [...density]
  .filter((d) => d.count > 1)
  .map((d) => d.year);

// Tooltip payload for the density chart (same floating tooltip as charts)
const densityTips = JSON.stringify(
  density.map((d) => ({
    label: String(d.year),
    value: `${d.count} milestone${d.count === 1 ? "" : "s"}`,
    f: maxCount > 0 ? d.count / maxCount : 0,
  })),
);
---

<BaseLayout
  ogImage="/og-image/then.png"
  title="Then"
  description="A milestone timeline of India, 1947–2014 — constitution to digital foundations."
>
  <header class="pt-14 md:pt-16 pb-6">
    <Container size="wide">
      <div
        class="flex items-center gap-2 text-saffron-600 font-semibold text-xs uppercase tracking-[0.25em] mb-3"
      >
        <MilestoneIcon size={15} stroke-width={2.5} />
        Then · 1947–2014
      </div>
      <h1
        class="font-display text-4xl md:text-5xl font-bold text-ink leading-[1.05] max-w-2xl tracking-tight"
      >
        How we got here
      </h1>
      <p class="mt-4 text-lg text-ink/70 leading-relaxed max-w-2xl">
        One timeline, four eras, <strong class="text-ink">{total} milestones</strong>.
        Grouped by year, told in plain words — no more, no less. Filter by sector
        to follow a thread, or walk the whole line.
      </p>

      <!-- Density: milestones per year -->
      <figure class="mt-8" aria-label="Milestones per year, 1947 to 2014">
        <div
          class="chart-svg chart-hover relative"
          data-chart
          data-bar
          data-title="Milestones per year"
          data-tips={densityTips}
          data-w={DW}
          data-h={DH}
          data-padl="0"
          data-padr="0"
          data-padt={padT}
          data-padb={padB}
        >
          <svg
            viewBox={`0 0 ${DW} ${DH}`}
            width="100%"
            height="auto"
            class="w-full h-auto block"
            role="img"
            aria-label="Milestones per year, 1947 to 2014"
          >
            <!-- baseline -->
            <line
              x1="0"
              y1={DH - padB}
              x2={DW}
              y2={DH - padB}
              stroke="var(--color-line)"
              stroke-width="1"></line>
            <!-- era dividers -->
            {
              eraDividers.map((d) => (
                <line
                  x1={d.x}
                  y1={padT}
                  x2={d.x}
                  y2={DH - padB}
                  stroke="var(--color-line)"
                  stroke-width="1"
                  stroke-dasharray="3 4"
                />
              ))
            }
            <!-- bars -->
            {
              bars.map((b) => (
                <rect
                  x={b.x}
                  y={b.y}
                  width={b.w}
                  height={b.h}
                  rx="1.5"
                  fill={b.count > 1 ? "#b45309" : "#d97706"}
                  opacity={b.count > 0 ? 1 : 0}
                />
              ))
            }
          </svg>
          <div class="chart-tip"></div>
        </div>
        <!-- responsive axis labels -->
        <div class="relative h-4 mt-1" aria-hidden="true">
          {
            axisTicks.map((t) => (
              <span
                class="absolute -translate-x-1/2 text-[10px] sm:text-[11px] font-mono text-fog"
                style={`left:${t.pct}%`}
              >
                {t.year}
              </span>
            ))
          }
        </div>
        <figcaption class="text-xs text-fog mt-1">
          Milestones per year, 1947–2014 — the darker bars are the{" "}
          <strong class="text-ink">{peakYears.length} years</strong> where more
          than one milestone landed.
        </figcaption>
      </figure>
    </Container>
  </header>

      <!-- Era jump + sector filter -->
      <section class="pt-6 pb-4">
    <Container size="wide">
      <nav aria-label="Jump to era" class="flex flex-wrap items-center gap-2">
        {
          byEra.map((era) => (
            <a
              href={`#${era.id}`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold border border-line bg-paper-2 text-ink/70 hover:border-navy hover:text-navy transition-colors"
            >
              <span class="text-saffron-600">{era.range}</span>
              {era.name}
            </a>
          ))
        }
      </nav>

      <div class="mt-4 flex items-center gap-3">
        <label
          for="year-jump"
          class="text-[11px] font-semibold uppercase tracking-wide text-fog shrink-0"
        >
          Jump to year
        </label>
        <input
          id="year-jump"
          type="range"
          min={startYear}
          max={endYear}
          value={startYear}
          step="1"
          list="year-ticks"
          class="year-jump-range flex-1 min-w-0"
          aria-label="Jump to a year"
        />
        <datalist id="year-ticks">
          {axisTicks.map((t) => <option value={t.year}></option>)}
        </datalist>
        <output
          id="year-jump-val"
          class="font-mono text-sm font-bold text-navy tabular-nums w-14 text-right"
        >
          {startYear}
        </output>
      </div>

      <div class="mt-5 flex flex-wrap gap-2" id="sector-filter">
        <button
          data-sector="all"
          aria-pressed="true"
          class="sector-chip inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-xs font-semibold border border-navy bg-navy text-paper transition-colors"
        >
          All sectors
        </button>
        {
          SECTORS.map((s) => {
            const Icon = SECTOR_ICONS[s.id];
            return (
              <button
                data-sector={s.id}
                aria-pressed="false"
                class="sector-chip inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-xs font-semibold border border-line bg-paper-2 text-ink/70 hover:border-navy hover:text-navy transition-colors"
              >
                <Icon size={14} stroke-width={2.3} />
                {s.name}
              </button>
            );
          })
        }
      </div>

      <!-- content-width separator -->
      <div class="mt-6 h-px w-full bg-line" aria-hidden="true"></div>
      <p id="then-filter-count" aria-live="polite" class="sr-only">
        {total} milestones
      </p>
    </Container>
  </section>

  <p class="then-no-results hidden max-w-6xl mx-auto px-5 md:px-8 pb-8 text-sm text-fog italic">
    No milestones match the selected sector. Try another.
  </p>

  <div class="pb-16">
    {
      byEra.map((era) => {
        const EraIcon = ERA_ICONS[era.id];
        return (
          <section data-era={era.id} id={era.id} class="scroll-mt-24">
            <Container size="wide">
              <div class="flex items-center gap-3 pt-10 mb-1">
                <span class="grid place-items-center w-11 h-11 rounded-2xl bg-navy text-paper shadow-card">
                  <EraIcon size={22} stroke-width={2} />
                </span>
                <div>
                  <h2 class="font-display text-2xl font-bold text-ink leading-tight">
                    {era.name}
                  </h2>
                  <span class="text-sm font-mono font-medium text-saffron-600">
                    {era.range}
                  </span>
                </div>
              </div>
              <p class="text-sm text-fog leading-relaxed mb-8 max-w-xl md:ml-14">
                {era.description}
              </p>

              <ol class="relative">
                <span
                  class="absolute left-[6px] top-2 bottom-2 w-[2px] bg-gradient-to-b from-navy-300 via-line to-line"
                  aria-hidden="true"
                />
                {era.yearGroups.map((yg) => (
                  <li data-year-group class="relative pb-7">
                    <div class="relative mb-3 pl-10">
                      <span
                        class="absolute left-0 top-0.5 w-3.5 h-3.5 rounded-full bg-navy ring-4 ring-paper"
                        aria-hidden="true"
                      />
                      <h3 class="font-mono text-lg font-bold text-navy tabular-nums leading-none">
                        {yg.year}
                      </h3>
                    </div>

                    <div class="space-y-3 pl-10">
                      {yg.milestones.map((m) => {
                        const SectorIcon = SECTOR_ICONS[m.sector];
                        return (
                          <article
                            data-sector={m.sector}
                            class="milestone scroll-mt-24 rounded-2xl border border-line bg-paper-2 p-5"
                            id={m.anchor}
                          >
                            <h4 class="font-display font-bold text-ink leading-snug">
                              {m.title}
                            </h4>
                            <p class="mt-2 text-sm text-fog leading-relaxed">
                              {m.summary}
                            </p>
                            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-ink/60">
                                <SectorIcon size={13} stroke-width={2.2} />
                                {SECTORS.find((s) => s.id === m.sector)?.name}
                              </span>
                              {m.relatedNow && (
                                <a
                                  href={m.relatedNow}
                                  class="inline-flex items-center gap-1 text-xs font-semibold text-navy hover:text-saffron-600 transition-colors"
                                >
                                  See where it stands
                                  <ArrowRight size={13} stroke-width={2.5} />
                                </a>
                              )}
                            </div>
                          </article>
                        );
                      })}
                    </div>
                  </li>
                ))}
              </ol>
            </Container>
          </section>
        );
      })
    }
  </div>

  <div class="pb-16">
    <Container size="wide">
      <p class="text-sm text-fog leading-relaxed border-t border-line pt-6 max-w-2xl">
        The timeline ends at 2014 deliberately — not because nothing happened
        after, but because the <em>now</em> of this journal is told in data, not
        milestones. The post-2014 acceleration is visible in every chart on{" "}
        <a
          href="/now"
          class="font-semibold text-navy hover:text-saffron-600">Now</a
        >, starting from 1947 wherever the data allows.
      </p>
    </Container>
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".sector-chip");
    const yearGroups = document.querySelectorAll<HTMLElement>(
      "[data-year-group]",
    );
    const countEl = document.getElementById("then-filter-count");
    const noResults = document.querySelector(".then-no-results");

    const ACTIVE = ["border-navy", "bg-navy", "text-paper"];
    const INACTIVE = [
      "border-line",
      "bg-paper-2",
      "text-ink/70",
      "hover:border-navy",
      "hover:text-navy",
    ];

    const setActive = (sector: string) => {
      let visible = 0;
      document.querySelectorAll<HTMLElement>(".milestone").forEach((el) => {
        const match = sector === "all" || el.dataset.sector === sector;
        el.style.display = match ? "" : "none";
        if (match) visible++;
      });
      yearGroups.forEach((group) => {
        const vis = group.querySelectorAll<HTMLElement>(
          '.milestone:not([style*="display: none"])',
        ).length;
        group.style.display = vis > 0 ? "" : "none";
      });
      if (countEl)
        countEl.textContent = `${visible} milestone${visible === 1 ? "" : "s"} in view`;
      if (noResults)
        (noResults as HTMLElement).classList.toggle("hidden", visible > 0);
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const sector = btn.dataset.sector ?? "all";
        buttons.forEach((b) => {
          b.classList.remove(...ACTIVE);
          b.classList.add(...INACTIVE);
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.remove(...INACTIVE);
        btn.classList.add(...ACTIVE);
        btn.setAttribute("aria-pressed", "true");
        setActive(sector);
        const url = new URL(window.location.href);
        if (sector === "all") url.searchParams.delete("sector");
        else url.searchParams.set("sector", sector);
        history.replaceState(null, "", url);
      });
    });

    // Year jump: slide to a year, scroll to the nearest year group
    const slider = document.getElementById(
      "year-jump",
    ) as HTMLInputElement | null;
    const out = document.getElementById("year-jump-val");
    if (slider && out) {
      const years = Array.from(yearGroups).map((g) => ({
        el: g,
        y: Number(
          g.querySelector("h3")?.textContent ?? g.dataset.year ?? "1947",
        ),
      }));
      const jump = () => {
        const target = Number(slider.value);
        out.textContent = String(target);
        let best = years[0];
        let bestd = Infinity;
        for (const w of years) {
          const d = Math.abs(w.y - target);
          if (d < bestd) {
            bestd = d;
            best = w;
          }
        }
        best?.el.scrollIntoView({ behavior: "smooth", block: "start" });
      };
      slider.addEventListener("input", () => {
        if (out) out.textContent = slider.value;
      });
      slider.addEventListener("change", jump);
    }

    const initial = new URLSearchParams(location.search).get("sector");
    if (initial) {
      document
        .querySelector<HTMLButtonElement>(
          `.sector-chip[data-sector="${initial}"]`,
        )
        ?.click();
    }
  </script>
</BaseLayout>
