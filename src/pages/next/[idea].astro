---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const ideas = await getCollection("ideas");
  return ideas.map((idea) => ({ params: { idea: idea.id }, props: { idea } }));
}

const { idea } = Astro.props;
const { Content } = await render(idea);
const submissions = idea.data.submissions;
---

<BaseLayout title={idea.data.title} description={idea.data.description}>
  <article class="pt-12 pb-8 max-w-3xl mx-auto">
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <StatusBadge status={idea.data.status} />
        <span class="text-xs text-fog">
          {idea.data.origin === "my-proposal"
            ? "My proposal"
            : "Government initiative"}
          {idea.data.recipient ? ` · addressed to ${idea.data.recipient}` : ""}
        </span>
      </div>
      <h1 class="font-display text-3xl md:text-4xl font-bold text-ink leading-tight">
        {idea.data.title}
      </h1>
      <p class="mt-3 text-ink/70 leading-relaxed">{idea.data.description}</p>
    </header>

    <div class="prose prose-stone max-w-none">
      <Content />
    </div>

    <aside class="mt-10 rounded-lg border border-stone-300 bg-cream/70 p-5">
      <h3 class="font-display font-bold text-sm uppercase tracking-wide text-ink mb-3">
        Submission record
      </h3>
      {
        submissions.length === 0 ? (
          <p class="text-sm text-fog">
            Not yet submitted. Channels being considered are listed on the{" "}
            <a href="/about#submission-strategy" class="text-navy underline underline-offset-2">
              About
            </a>{" "}
            page. When filed, the platform, date, and any reference number will
            appear here, with an archived copy of what was sent.
          </p>
        ) : (
          <ul class="space-y-3">
            {submissions.map((s) => (
              <li class="text-sm">
                <span class="font-medium text-ink">{s.platform}</span>{" "}
                · {s.channel} · {s.date}
                {s.referenceNumber && (
                  <span class="font-mono text-xs text-fog"> · ref {s.referenceNumber}</span>
                )}
              </li>
            ))}
          </ul>
        )
      }
      {
        idea.data.statusNote && (
          <p class="mt-3 text-sm text-fog">{idea.data.statusNote}</p>
        )
      }
    </aside>

    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a href="/next" class="text-navy underline underline-offset-2 hover:decoration-navy">
        ← All ideas
      </a>
      {
        idea.data.relatedNow && (
          <a
            href={idea.data.relatedNow}
            class="text-navy underline underline-offset-2 hover:decoration-navy"
          >
            See where this stands today → Now
          </a>
        )
      }
    </div>
  </article>
</BaseLayout>
