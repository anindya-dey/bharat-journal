---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import {
  Compass,
  Check,
  ShieldAlert,
  UserRound,
  GitBranch,
} from "@lucide/astro";
import { SITE } from "../data/site";

const methodPoints = [
  {
    strong: "Charts start at 1947",
    rest: "or at the earliest year the data exists. The point is the trajectory, not a flattering window. Milestone annotations mark policy events, never election years.",
  },
  {
    strong: "Every figure is sourced and dated",
    rest: "on the page that uses it, with a link and a \"data as of\" date. Datasets live in the repo as JSON, so a figure can be traced from chart to source.",
  },
  {
    strong: "Unverified is labelled unverified.",
    rest: "Where a claim couldn't be independently confirmed, the text says so rather than presenting it as fact.",
  },
  {
    strong: "Ideas get an anatomy, not a wish.",
    rest: "Each idea states where it was seen, what's missing, what India already has nearby, and a concrete ask.",
  },
];

const principles = [
  {
    strong: "Progress first.",
    rest: "This is a record of what India has built and could build — not a place for complaints or blame.",
  },
  {
    strong: "Plain words.",
    rest: "Facts stated simply, with the sources alongside so anyone can check them.",
  },
  {
    strong: "A living document.",
    rest: "Timeline entries, data stories and ideas are added and revised over time, and corrections are noted openly.",
  },
];
---

<BaseLayout
  title="About"
  description={`About ${SITE.title} — what it is, how it's made, and how to read it.`}
>
  <article class="pt-14 pb-16">
    <Container>
      <h1
        class="font-display text-3xl md:text-4xl font-bold text-ink leading-tight tracking-tight"
      >
        About this journal
      </h1>
      <p class="mt-4 text-lg text-ink/70 leading-relaxed">
        {SITE.title} is one citizen's public record of India's progress and its
        possibilities. It has three views —{" "}
        <a
          href="/then"
          class="font-semibold text-navy hover:text-saffron-600">Then</a
        >,{" "}
        <a
          href="/now"
          class="font-semibold text-navy hover:text-saffron-600">Now</a
        >, and{" "}
        <a
          href="/next"
          class="font-semibold text-navy hover:text-saffron-600">Next</a
        > — because a credible argument about the future has to show its work
        about the past.
      </p>

      <section class="mt-12 scroll-mt-32" id="what">
        <h2
          class="flex items-center gap-2.5 font-display text-2xl font-bold text-ink mb-4"
        >
          <span
            class="grid place-items-center w-9 h-9 rounded-xl bg-navy/5 text-navy"
          >
            <Compass size={18} stroke-width={2.2} />
          </span>
          What it is
        </h2>
        <ul class="space-y-4">
          {
            principles.map((p) => (
              <li class="flex gap-3 text-ink/80 leading-relaxed">
                <Check
                  size={18}
                  stroke-width={2.6}
                  class="mt-0.5 shrink-0 text-moss"
                />
                <span>
                  <strong class="text-ink">{p.strong}</strong> {p.rest}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-12 scroll-mt-32" id="method">
        <h2
          class="flex items-center gap-2.5 font-display text-2xl font-bold text-ink mb-4"
        >
          <span
            class="grid place-items-center w-9 h-9 rounded-xl bg-saffron-100 text-saffron-600"
          >
            <GitBranch size={18} stroke-width={2.2} />
          </span>
          Method
        </h2>
        <ul class="space-y-4">
          {
            methodPoints.map((p) => (
              <li class="flex gap-3 text-ink/80 leading-relaxed">
                <Check
                  size={18}
                  stroke-width={2.6}
                  class="mt-0.5 shrink-0 text-moss"
                />
                <span>
                  <strong class="text-ink">{p.strong}</strong> {p.rest}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-12 scroll-mt-32" id="corrections">
        <h2
          class="flex items-center gap-2.5 font-display text-2xl font-bold text-ink mb-4"
        >
          <span
            class="grid place-items-center w-9 h-9 rounded-xl bg-clay/10 text-clay"
          >
            <ShieldAlert size={18} stroke-width={2.2} />
          </span>
          Corrections
        </h2>
        <p class="text-ink/80 leading-relaxed">
          This journal errs on the side of citability. If a figure, date, or
          framing is wrong, it gets fixed visibly — corrections are noted on the
          page, not silently overwritten. The repository is public: raise a
          correction by opening an{" "}
          <a
            href="https://github.com/anindyadey/bharat-journal/issues"
            class="font-semibold text-navy hover:text-saffron-600">issue</a
          >, or send a{" "}
          <a
            href="https://github.com/anindyadey/bharat-journal/pulls"
            class="font-semibold text-navy hover:text-saffron-600"
            >pull request</a
          >{" "}
          for a rectification. Both are welcome.
        </p>
      </section>

      <section class="mt-12 scroll-mt-32" id="author">
        <h2
          class="flex items-center gap-2.5 font-display text-2xl font-bold text-ink mb-4"
        >
          <span
            class="grid place-items-center w-9 h-9 rounded-xl bg-navy/5 text-navy"
          >
            <UserRound size={18} stroke-width={2.2} />
          </span>
          Author
        </h2>
        <p class="text-ink/80 leading-relaxed">
          {SITE.author} — born 1992, writing from the vantage of a generation that
          grew up inside the changes this journal charts. Day job: software.
          Longer writing lives at{" "}
          <a
            href="https://blog.anindyadey.com"
            class="font-semibold text-navy hover:text-saffron-600"
            >blog.anindyadey.com</a
          >.
        </p>
      </section>
    </Container>
  </article>
</BaseLayout>
