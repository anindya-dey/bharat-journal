---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import {
  Compass,
  Send,
  ShieldAlert,
  UserRound,
  Check,
  ArrowRight,
} from "@lucide/astro";
import { SITE } from "../data/site";

const methodPoints = [
  {
    strong: "Every chart starts at 1947",
    rest: "or at the earliest year its data exists. The point is trajectory, not a flattering window. Milestone annotations mark policy events, never election years.",
  },
  {
    strong: "Every figure is sourced and dated",
    rest: "on the page that uses it, with a link and a \"data as of\" date. Datasets live in the repo as JSON, so a figure can be traced from chart to source.",
  },
  {
    strong: "Unverified is labelled unverified.",
    rest: "Where a claim couldn't be independently confirmed, the text says so rather than laundering it into fact.",
  },
  {
    strong: "Ideas get an anatomy, not a wish.",
    rest: "Each idea states where it was seen (spark), what the gap actually is, what already exists nearby (precedent), and a concrete, pilot-scale ask.",
  },
];

const submissionPoints = [
  {
    strong: "Respond to open consultations",
    rest: "— a comment on an open ministry consultation is read; a cold submission usually isn't.",
  },
  {
    strong: "Match the channel to the idea",
    rest: "— tourism ideas to the Ministry of Tourism and MyGov campaigns; payments ideas to RBI/NPCI; city infrastructure to state urban departments and municipal corporations.",
  },
  {
    strong: "CPGRAMS for a trackable reference",
    rest: "— it issues registration numbers that can be followed up.",
  },
  {
    strong: "RTI as follow-up",
    rest: "— if a submission goes unanswered, a Right to Information application asking what action was taken is cheap and must be answered.",
  },
  {
    strong: "Archive everything",
    rest: "— each submission is recorded with platform, date, reference number, and an archived copy; personal details are redacted from anything published.",
  },
];
---

<BaseLayout
  title="About"
  description={`About ${SITE.title} — method, sources, corrections, and how ideas are submitted to government.`}
>
  <article class="pt-14 pb-16">
    <Container>
      <h1
        class="font-display text-3xl md:text-4xl font-bold text-ink leading-tight tracking-tight"
      >
        About this journal
      </h1>
      <p class="mt-4 text-lg text-ink/70 leading-relaxed">
        {SITE.title} is one citizen's public record of India's progress and its
        possibilities. It has three views —
        <a href="/then" class="font-semibold text-navy hover:text-saffron-600"
          >Then</a
        >,
        <a href="/now" class="font-semibold text-navy hover:text-saffron-600"
          >Now</a
        >, and
        <a href="/next" class="font-semibold text-navy hover:text-saffron-600"
          >Next</a
        > — because a credible argument about the future has to show its work
        about the past.
      </p>

      <section class="mt-12 scroll-mt-32" id="method">
        <h2
          class="flex items-center gap-2.5 font-display text-2xl font-bold text-ink mb-4"
        >
          <span
            class="grid place-items-center w-9 h-9 rounded-xl bg-navy/5 text-navy"
          >
            <Compass size={18} stroke-width={2.2} />
          </span>
          Method
        </h2>
        <ul class="space-y-4">
          {
            methodPoints.map((p) => (
              <li class="flex gap-3 text-ink/80 leading-relaxed">
                <Check
                  size={18}
                  stroke-width={2.6}
                  class="mt-0.5 shrink-0 text-moss"
                />
                <span>
                  <strong class="text-ink">{p.strong}</strong> {p.rest}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-12 scroll-mt-32" id="submission-strategy">
        <h2
          class="flex items-center gap-2.5 font-display text-2xl font-bold text-ink mb-4"
        >
          <span
            class="grid place-items-center w-9 h-9 rounded-xl bg-saffron-100 text-saffron-600"
          >
            <Send size={18} stroke-width={2.2} />
          </span>
          How ideas reach government
        </h2>
        <p class="text-ink/80 leading-relaxed">
          A journal page doesn't reach anyone in government by itself — it has to
          be filed where it counts. The strategy, per idea:
        </p>
        <ul class="mt-4 space-y-3.5">
          {
            submissionPoints.map((p) => (
              <li class="flex gap-3 text-ink/80 leading-relaxed">
                <ArrowRight
                  size={18}
                  stroke-width={2.6}
                  class="mt-0.5 shrink-0 text-saffron-600"
                />
                <span>
                  <strong class="text-ink">{p.strong}</strong> {p.rest}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-fog italic">
          Portal URLs and current consultation windows are verified at filing
          time, not cached here — government portals reorganise often.
        </p>
      </section>

      <section class="mt-12 scroll-mt-32" id="corrections">
        <h2
          class="flex items-center gap-2.5 font-display text-2xl font-bold text-ink mb-4"
        >
          <span
            class="grid place-items-center w-9 h-9 rounded-xl bg-clay/10 text-clay"
          >
            <ShieldAlert size={18} stroke-width={2.2} />
          </span>
          Corrections
        </h2>
        <p class="text-ink/80 leading-relaxed">
          This journal errs on the side of citability. If a figure, date, or
          framing is wrong, it gets fixed visibly — corrections are noted on the
          page, not silently overwritten. Report one via the repo's issue
          tracker, or through the contact channels on
          <a
            href="https://blog.anindyadey.com"
            class="font-semibold text-navy hover:text-saffron-600"
            >the author's blog</a
          >.
        </p>
      </section>

      <section class="mt-12 scroll-mt-32" id="author">
        <h2
          class="flex items-center gap-2.5 font-display text-2xl font-bold text-ink mb-4"
        >
          <span
            class="grid place-items-center w-9 h-9 rounded-xl bg-navy/5 text-navy"
          >
            <UserRound size={18} stroke-width={2.2} />
          </span>
          Author
        </h2>
        <p class="text-ink/80 leading-relaxed">
          {SITE.author} — born 1992, writing from the vantage of a generation that
          grew up inside the changes this journal charts. Day job: software.
          Longer writing lives at
          <a
            href="https://blog.anindyadey.com"
            class="font-semibold text-navy hover:text-saffron-600"
            >blog.anindyadey.com</a
          >.
        </p>
      </section>
    </Container>
  </article>
</BaseLayout>
