---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { getCollection } from "astro:content";

const ORIGIN_LABELS: Record<string, string> = {
  "my-proposal": "My proposal",
  "government-initiative": "Government initiative",
};

const ideas = (await getCollection("ideas")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
  title="Next"
  description="Ideas for India's next milestones — proposals with spark, gap, precedent, ask, and a public submission record."
>
  <section class="pt-12 pb-6">
    <p class="text-xs uppercase tracking-[0.25em] text-ember font-semibold mb-2">
      Next · ideas
    </p>
    <h1 class="font-display text-3xl md:text-4xl font-bold text-ink">
      Where we could go
    </h1>
    <p class="mt-3 text-ink/70 leading-relaxed max-w-2xl">
      Every idea is written the same honest way: where it was seen, what the
      gap <em>actually</em> is, what India already has nearby, and the concrete
      ask. Ideas that get submitted are tracked in the open — and achieved
      ideas move into the <a href="/now" class="text-navy underline underline-offset-2">Now</a> section as data.
    </p>
  </section>

  <div class="grid md:grid-cols-2 gap-4">
    {
      ideas.map((idea) => (
        <a
          href={`/next/${idea.id}`}
          class="rounded-xl border border-stone-300 bg-white p-6 hover:border-navy hover:shadow-md transition-all flex flex-col"
        >
          <div class="flex items-center justify-between gap-3 mb-3">
            <StatusBadge status={idea.data.status} />
            <span class="text-xs text-fog">
              {ORIGIN_LABELS[idea.data.origin]}
            </span>
          </div>
          <h3 class="font-display text-lg font-bold text-ink leading-snug">
            {idea.data.title}
          </h3>
          <p class="mt-2 text-sm text-fog leading-relaxed line-clamp-3">
            {idea.data.description}
          </p>
          <div class="mt-auto pt-3 flex flex-wrap gap-1.5">
            {idea.data.themes.slice(0, 4).map((t) => (
              <span class="px-2 py-0.5 rounded-full bg-cream border border-stone-300 text-xs text-fog">
                {t}
              </span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
