---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { getCollection } from "astro:content";
import { Lightbulb, ArrowRight } from "@lucide/astro";
import { DOMAINS, domainForIdea } from "../lib/domains";

const ORIGIN_LABELS: Record<string, string> = {
  "my-proposal": "My idea",
  "government-initiative": "Government initiative",
};

const STATUS_ORDER = [
  { id: "idea", label: "Idea" },
  { id: "proposed", label: "Proposed to govt" },
  { id: "in-progress", label: "In progress" },
  { id: "achieved", label: "Achieved" },
];

const ORIGIN_OPTIONS = [
  { id: "all", label: "All ideas" },
  { id: "mine", label: "My ideas" },
  { id: "in-motion", label: "Already in motion" },
];

const ideas = (await getCollection("ideas"))
  .map((i) => ({
    ...i,
    domain: domainForIdea(i.data.themes),
    group: i.data.origin === "my-proposal" ? "mine" : "in-motion",
  }))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const presentStatuses = new Set<string>(ideas.map((i) => i.data.status));
const STATUS_FILTERS = [
  { id: "all", label: "All" },
  ...STATUS_ORDER.filter((s) => presentStatuses.has(s.id)),
];

const originCount = (id: string) =>
  id === "all" ? ideas.length : ideas.filter((i) => i.group === id).length;
const domainCount = (id: string) =>
  id === "all" || id === "other"
    ? ideas.length
    : ideas.filter((i) => i.domain === id).length;
const domainLabel = (id: string) =>
  DOMAINS.find((d) => d.id === id)?.label ?? id;
const statusCount = (id: string) =>
  id === "all" ? ideas.length : ideas.filter((i) => i.data.status === id).length;

const domainOptions = DOMAINS.filter((d) => domainCount(d.id) > 0);
---

<BaseLayout
  title="Next"
  description="Ideas for India's next milestones — proposals with where they were seen, what's missing, what already exists, and a concrete ask."
  ogImage="/og-image/next.png"
>
  <PageHeader
    eyebrow="Next · ideas"
    title="Where we could go"
    Icon={Lightbulb}
    description="New proposals I'd like to see piloted, and big bets the government has already begun. Every idea states where it was seen, what the gap actually is, what already exists nearby, and a concrete ask."
  >
  </PageHeader>

  <section class="pb-6" id="idea-filter">
    <Container size="wide">
      <div
        class="flex flex-wrap items-center gap-2"
        role="group"
        aria-label="Filter by status"
      >
        {
          STATUS_FILTERS.map((s) => (
            <button
              data-status={s.id}
              aria-pressed={s.id === "all" ? "true" : "false"}
              class:list={[
                "status-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] font-semibold transition-colors",
                s.id === "all"
                  ? "border border-navy bg-navy text-paper"
                  : "border border-line bg-paper-2 text-fog hover:border-navy hover:bg-navy hover:text-paper",
              ]}
            >
              {s.label}
              <span class="opacity-60 tabular-nums">
                {statusCount(s.id)}
              </span>
            </button>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
        <label class="flex items-center gap-2">
          <span
            class="text-[11px] font-semibold uppercase tracking-wide text-fog"
            >Ideas</span
          >
          <select
            id="origin-select"
            class="filter-select rounded-lg border border-line bg-paper-2 text-xs font-semibold text-ink/80 px-2.5 py-1.5 cursor-pointer"
          >
            {
              ORIGIN_OPTIONS.map((o) => (
                <option value={o.id}>
                  {o.label} ({originCount(o.id)})
                </option>
              ))
            }
          </select>
        </label>

        <label class="flex items-center gap-2">
          <span
            class="text-[11px] font-semibold uppercase tracking-wide text-fog"
            >Category</span
          >
          <select
            id="domain-select"
            class="filter-select rounded-lg border border-line bg-paper-2 text-xs font-semibold text-ink/80 px-2.5 py-1.5 cursor-pointer"
          >
            <option value="all">All categories ({ideas.length})</option>
            {
              domainOptions.map((d) => (
                <option value={d.id}>
                  {d.label} ({domainCount(d.id)})
                </option>
              ))
            }
          </select>
        </label>

        <label class="flex items-center gap-2">
          <span
            class="text-[11px] font-semibold uppercase tracking-wide text-fog"
            >Sort</span
          >
          <select
            id="sort-select"
            class="filter-select rounded-lg border border-line bg-paper-2 text-xs font-semibold text-ink/80 px-2.5 py-1.5 cursor-pointer"
          >
            <option value="title">Title A–Z</option>
            <option value="recent">Recently updated</option>
          </select>
        </label>
      </div>
    </Container>
  </section>

  <p id="filter-count" aria-live="polite" class="sr-only">{ideas.length} ideas</p>

  <div class="pb-20">
    <Container size="wide">
      <div class="grid md:grid-cols-2 gap-4" data-reveal id="idea-grid">
        {
          ideas.map((idea) => (
            <a
              href={`/next/${idea.id}`}
              data-domain={idea.domain}
              data-status={idea.data.status}
              data-origin={idea.group}
              data-updated={idea.data.updated}
              class="idea-card group rounded-2xl border border-line bg-paper-2 p-6 shadow-card hover:shadow-lift hover:-translate-y-0.5 hover:border-navy/30 transition-all flex flex-col"
            >
              <div class="flex items-center justify-between gap-3 mb-3">
                <StatusBadge status={idea.data.status} />
                <span class="text-xs font-medium text-fog">
                  {ORIGIN_LABELS[idea.data.origin]}
                </span>
              </div>
              <h3 class="font-display text-lg font-bold text-ink leading-snug group-hover:text-navy transition-colors">
                {idea.data.title}
              </h3>
              <p class="mt-2 text-sm text-fog leading-relaxed line-clamp-2">
                {idea.data.description}
              </p>
              <div class="mt-auto pt-4 flex items-center justify-between gap-3">
                <span class="text-[11px] font-medium text-fog">
                  {domainLabel(idea.domain as string)}
                </span>
                <ArrowRight
                  size={16}
                  class="text-fog group-hover:text-navy group-hover:translate-x-0.5 transition-all shrink-0"
                />
              </div>
            </a>
          ))
        }
      </div>
      <p class="no-results hidden mt-4 text-sm text-fog italic">
        No ideas match the current filters.
      </p>
    </Container>
  </div>

  <script>
    const originSelect = document.getElementById(
      "origin-select",
    ) as HTMLSelectElement | null;
    const domainSelect = document.getElementById(
      "domain-select",
    ) as HTMLSelectElement | null;
    const statusButtons = document.querySelectorAll<HTMLButtonElement>(
      ".status-chip",
    );
    const cards = document.querySelectorAll<HTMLElement>(".idea-card");
    const grid = document.getElementById("idea-grid");
    const countEl = document.getElementById("filter-count");
    const noResults = document.querySelector(".no-results");
    const sortSelect = document.getElementById(
      "sort-select",
    ) as HTMLSelectElement | null;

    const S_ACTIVE = ["border-navy", "bg-navy", "text-paper"];
    const S_INACTIVE = ["border-line", "bg-paper-2", "text-fog"];

    let origin = originSelect?.value ?? "all";
    let domain = domainSelect?.value ?? "all";
    let status = "all";

    function applyFilters() {
      let visible = 0;
      cards.forEach((el) => {
        const oOk = origin === "all" || el.dataset.origin === origin;
        const dOk = domain === "all" || el.dataset.domain === domain;
        const sOk = status === "all" || el.dataset.status === status;
        const match = oOk && dOk && sOk;
        el.style.display = match ? "" : "none";
        if (match) visible++;
      });
      if (countEl)
        countEl.textContent = `${visible} idea${visible === 1 ? "" : "s"} visible`;
      if (noResults)
        (noResults as HTMLElement).classList.toggle("hidden", visible > 0);
    }

    function applySort(mode: string) {
      if (!grid) return;
      const items = [...grid.children] as HTMLElement[];
      if (mode === "recent") {
        items.sort(
          (a, b) =>
            (b.dataset.updated ?? "").localeCompare(a.dataset.updated ?? "") ||
            (a.querySelector("h3")?.textContent ?? "").localeCompare(
              b.querySelector("h3")?.textContent ?? "",
            ),
        );
      } else {
        items.sort((a, b) =>
          (a.querySelector("h3")?.textContent ?? "").localeCompare(
            b.querySelector("h3")?.textContent ?? "",
          ),
        );
      }
      items.forEach((i) => grid.appendChild(i));
    }

    function persist(key: string, value: string) {
      const url = new URL(window.location.href);
      if (!value || value === "all") url.searchParams.delete(key);
      else url.searchParams.set(key, value);
      history.replaceState(null, "", url);
    }

    originSelect?.addEventListener("change", () => {
      origin = originSelect.value;
      applyFilters();
      persist("origin", origin);
    });

    domainSelect?.addEventListener("change", () => {
      domain = domainSelect.value;
      applyFilters();
      persist("domain", domain);
    });

    statusButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        status = btn.dataset.status ?? "all";
        statusButtons.forEach((b) => {
          b.classList.remove(...S_ACTIVE);
          b.classList.add(...S_INACTIVE);
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.remove(...S_INACTIVE);
        btn.classList.add(...S_ACTIVE);
        btn.setAttribute("aria-pressed", "true");
        applyFilters();
      });
    });

    sortSelect?.addEventListener("change", () => {
      applySort(sortSelect.value);
    });

    const params = new URLSearchParams(location.search);
    const initOrigin = params.get("origin");
    if (initOrigin && originSelect) {
      originSelect.value = initOrigin;
      origin = initOrigin;
    }
    const initDomain = params.get("domain");
    if (initDomain && domainSelect) {
      domainSelect.value = initDomain;
      domain = initDomain;
    }
    applyFilters();
  </script>
</BaseLayout>
