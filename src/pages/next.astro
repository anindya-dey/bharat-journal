---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { getCollection } from "astro:content";
import { Lightbulb, ArrowRight, Sparkles } from "@lucide/astro";

const ORIGIN_LABELS: Record<string, string> = {
  "my-proposal": "My proposal",
  "government-initiative": "Government initiative",
};

const ideas = (await getCollection("ideas")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const themes = [...new Set(ideas.flatMap((i) => i.data.themes))].sort();

const THEME_LABEL: Record<string, string> = {};
themes.forEach((t) => (THEME_LABEL[t] = t));

// Group: government initiatives first as "in motion", then my proposals by theme count
const grouped = [
  {
    id: "in-motion",
    label: "In motion — government initiatives",
    items: ideas.filter((i) => i.data.origin === "government-initiative"),
  },
  {
    id: "my-proposals",
    label: "My proposals",
    items: ideas.filter((i) => i.data.origin === "my-proposal"),
  },
].filter((g) => g.items.length > 0);

---

<BaseLayout
  title="Next"
  description="Ideas for India's next milestones — proposals with spark, gap, precedent, ask, and a public submission record."
>
  <PageHeader
    eyebrow="Next · ideas"
    title="Where we could go"
    Icon={Lightbulb}
    description="Every idea is written the same honest way: where it was seen, what the gap actually is, what India already has nearby, and the concrete ask. Submitted ideas are tracked in the open — achieved ideas move into Now as data."
  >
  </PageHeader>

  <section class="pb-6" id="idea-filter">
    <Container size="wide">
      <div class="flex flex-wrap gap-2">
        <button
          data-theme="all"
          aria-pressed="true"
          class="theme-chip inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-xs font-semibold border border-navy bg-navy text-paper transition-colors"
        >
          All themes
        </button>
        {
          themes.map((t) => (
            <button
              data-theme={t}
              aria-pressed="false"
              class="theme-chip inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-xs font-semibold border border-line bg-paper-2 text-ink/70 hover:border-navy hover:text-navy transition-colors"
            >
              <Sparkles size={12} stroke-width={2.4} />
              {t}
            </button>
          ))
        }
      </div>
    </Container>
  </section>

  <div class="pb-20 space-y-12" id="idea-groups">
    {
      grouped.map((group) => (
        <section data-group={group.id}>
          <Container size="wide">
            <div class="flex items-baseline gap-3 mb-5">
              <h2 class="font-display text-xl font-bold text-ink">
                {group.label}
              </h2>
              <span class="text-xs font-mono text-fog">
                {group.items.length}
              </span>
            </div>
            <div class="grid md:grid-cols-2 gap-4" data-reveal>
              {group.items.map((idea) => (
                <a
                  href={`/next/${idea.id}`}
                  data-themes={idea.data.themes.join(",")}
                  class="idea-card group rounded-2xl border border-line bg-paper-2 p-6 shadow-card hover:shadow-lift hover:-translate-y-0.5 hover:border-navy/30 transition-all flex flex-col"
                >
                  <div class="flex items-center justify-between gap-3 mb-3">
                    <StatusBadge status={idea.data.status} />
                    <span class="text-xs font-medium text-fog">
                      {ORIGIN_LABELS[idea.data.origin]}
                    </span>
                  </div>
                  <h3 class="font-display text-lg font-bold text-ink leading-snug group-hover:text-navy transition-colors">
                    {idea.data.title}
                  </h3>
                  <p class="mt-2 text-sm text-fog leading-relaxed line-clamp-3">
                    {idea.data.description}
                  </p>
                  <div class="mt-auto pt-4 flex items-end justify-between gap-3">
                    <div class="flex flex-wrap gap-1.5">
                      {idea.data.themes.slice(0, 3).map((t) => (
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-cream text-[11px] font-medium text-fog">
                          {t}
                        </span>
                      ))}
                    </div>
                    <ArrowRight
                      size={16}
                      class="text-fog group-hover:text-navy group-hover:translate-x-0.5 transition-all shrink-0"
                    />
                  </div>
                </a>
              ))}
            </div>
          </Container>
        </section>
      ))
    }
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".theme-chip");
    const cards = document.querySelectorAll<HTMLElement>(".idea-card");
    const groups = document.querySelectorAll<HTMLElement>("[data-group]");

    const ACTIVE = ["border-navy", "bg-navy", "text-paper"];
    const INACTIVE = [
      "border-line",
      "bg-paper-2",
      "text-ink/70",
      "hover:border-navy",
      "hover:text-navy",
    ];

    const setActive = (theme: string) => {
      cards.forEach((el) => {
        const themes = (el.dataset.themes ?? "").split(",");
        const match = theme === "all" || themes.includes(theme);
        el.style.display = match ? "" : "none";
      });
      groups.forEach((group) => {
        const visible = group.querySelectorAll<HTMLElement>(
          '.idea-card:not([style*="display: none"])',
        ).length;
        group.style.display = visible > 0 ? "" : "none";
      });
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const theme = btn.dataset.theme ?? "all";
        buttons.forEach((b) => {
          b.classList.remove(...ACTIVE);
          b.classList.add(...INACTIVE);
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.remove(...INACTIVE);
        btn.classList.add(...ACTIVE);
        btn.setAttribute("aria-pressed", "true");
        setActive(theme);
        const url = new URL(window.location.href);
        if (theme === "all") url.searchParams.delete("theme");
        else url.searchParams.set("theme", theme);
        history.replaceState(null, "", url);
      });
    });

    const initial = new URLSearchParams(location.search).get("theme");
    if (initial) {
      document
        .querySelector<HTMLButtonElement>(`.theme-chip[data-theme="${initial}"]`)
        ?.click();
    }
  </script>
</BaseLayout>
