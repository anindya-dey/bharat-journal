---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const THEME_LABELS: Record<string, string> = {
  money: "Money",
  mobility: "Mobility",
  livelihoods: "Livelihoods",
};

const vizs = (await getCollection("now")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const byTheme = Object.keys(THEME_LABELS).map((theme) => ({
  id: theme,
  label: THEME_LABELS[theme],
  vizs: vizs.filter((v) => v.data.theme === theme),
}));
---

<BaseLayout
  title="Now"
  description="Where India stands today — data visualisations with cited sources: UPI, Jan Dhan, rail electrification."
>
  <section class="pt-12 pb-6">
    <p class="text-xs uppercase tracking-[0.25em] text-ember font-semibold mb-2">
      Now · data
    </p>
    <h1 class="font-display text-3xl md:text-4xl font-bold text-ink">
      Where we stand
    </h1>
    <p class="mt-3 text-ink/70 leading-relaxed max-w-2xl">
      One aspect per page: a chart, its story, its sources, and what could come
      next. Every series starts in 1947 or at the earliest year its data
      exists — the trajectory speaks for itself, and you can check every
      number.
    </p>
  </section>

  {
    byTheme.map((theme) => (
      <section class="mb-12">
        <h2 class="font-display text-xl font-bold text-navy mb-4">
          {theme.label}
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {theme.vizs.map((v) => (
            <a
              href={`/now/${v.id}`}
              class="rounded-xl border border-stone-300 bg-white p-6 hover:border-navy hover:shadow-md transition-all flex flex-col"
            >
              <div class="text-xs font-mono text-ember mb-1.5">
                {v.data.unit}
              </div>
              <h3 class="font-display text-lg font-bold text-ink leading-snug">
                {v.data.title}
              </h3>
              <p class="mt-2 text-sm text-fog leading-relaxed line-clamp-3">
                {v.data.description}
              </p>
              <div class="mt-auto pt-3 text-xs text-fog">
                Updated {v.data.updated} · {v.data.sources.length} source
                {v.data.sources.length === 1 ? "" : "s"}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
