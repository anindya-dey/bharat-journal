---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import { getCollection } from "astro:content";
import {
  Wallet,
  TrainFront,
  Sprout,
  Wifi,
  Zap,
  Users,
  Rocket,
  ArrowRight,
  ChartColumn,
  ChartLine,
} from "@lucide/astro";

const THEMES = [
  { id: "money", label: "Money", Icon: Wallet },
  { id: "mobility", label: "Mobility", Icon: TrainFront },
  { id: "energy", label: "Energy", Icon: Zap },
  { id: "connectivity", label: "Connectivity", Icon: Wifi },
  { id: "society", label: "Society", Icon: Users },
  { id: "livelihoods", label: "Livelihoods", Icon: Sprout },
  { id: "space", label: "Space", Icon: Rocket },
];

const vizs = (await getCollection("now")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const byTheme = THEMES.map((theme) => ({
  ...theme,
  vizs: vizs.filter((v) => v.data.theme === theme.id),
})).filter((t) => t.vizs.length > 0);
---

<BaseLayout
  ogImage="/og-image/now.png"
  title="Now"
  description="Where India stands today — data visualisations with cited sources: UPI, Jan Dhan, rail electrification."
>
  <PageHeader
    eyebrow="Now · data"
    title="Where we stand"
    Icon={ChartColumn}
    description="One aspect per page: a chart, its story, its sources, and what could come next. Every series starts in 1947 or at the earliest year its data exists — the trajectory speaks for itself."
  >
  </PageHeader>

  <div class="pb-20 space-y-12">
    {
      byTheme.map((theme) => (
        <section>
          <Container size="wide">
            <div class="flex items-center gap-2.5 mb-5">
              <span class="grid place-items-center w-9 h-9 rounded-xl bg-navy/5 text-navy">
                <theme.Icon size={18} stroke-width={2.2} />
              </span>
              <h2 class="font-display text-xl font-bold text-ink">
                {theme.label}
              </h2>
            </div>
            <div class="grid md:grid-cols-2 gap-4" data-reveal>
              {theme.vizs.map((v) => {
                return (
                  <a
                    href={`/now/${v.id}`}
                    class="group rounded-2xl border border-line bg-paper-2 p-6 shadow-card hover:shadow-lift hover:-translate-y-0.5 hover:border-navy/30 transition-all flex flex-col"
                  >
                    <div class="flex items-center justify-between gap-3 mb-2">
                      <div class="flex items-center gap-2 text-xs font-mono text-saffron-600">
                        <ChartLine size={13} stroke-width={2.4} />
                        {v.data.unit}
                      </div>
                      <span class="text-[11px] text-fog">
                        Updated {v.data.updated}
                      </span>
                    </div>
                    <h3 class="font-display text-lg font-bold text-ink leading-snug group-hover:text-navy transition-colors">
                      {v.data.title}
                    </h3>
                    <p class="mt-2 text-sm text-fog leading-relaxed line-clamp-2">
                      {v.data.description}
                    </p>
                    <div class="mt-auto pt-4 flex items-center justify-between text-xs text-fog">
                      <span>
                        {v.data.sources.length} source
                        {v.data.sources.length === 1 ? "" : "s"}
                      </span>
                      <ArrowRight
                        size={15}
                        class="text-fog group-hover:text-navy group-hover:translate-x-0.5 transition-all"
                      />
                    </div>
                  </a>
                );
              })}
            </div>
          </Container>
        </section>
      ))
    }
  </div>
</BaseLayout>
