---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Prose from "../../components/Prose.astro";
import { getCollection, render } from "astro:content";
import { ChartColumn, CalendarDays, Database, Link2 } from "@lucide/astro";

export async function getStaticPaths() {
  const vizs = await getCollection("now");
  return vizs.map((v) => ({ params: { topic: v.id }, props: { viz: v } }));
}

const { viz } = Astro.props;
const { Content } = await render(viz);

const relatedIdeas = (await getCollection("ideas")).filter((i) =>
  i.data.relatedNow === `/now/${viz.id}`,
);
---

<BaseLayout
  title={viz.data.title}
  description={viz.data.description}
  type="article"
>
  <article class="pt-14 pb-16">
    <Container>
      <Breadcrumb
        crumbs={[
          { href: "/now", label: "Now" },
          { label: viz.data.title },
        ]}
      />
      <header class="mb-10">
        <div
          class="flex items-center gap-2 text-saffron-600 font-semibold text-xs uppercase tracking-[0.25em] mb-3"
        >
          <ChartColumn size={15} stroke-width={2.5} />
          Now · {viz.data.theme}
        </div>
        <h1
          class="font-display text-3xl md:text-4xl font-bold text-ink leading-tight tracking-tight"
        >
          {viz.data.title}
        </h1>
        <p class="mt-4 text-lg text-ink/70 leading-relaxed">
          {viz.data.description}
        </p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs font-medium text-fog">
          <span class="inline-flex items-center gap-1.5">
            <CalendarDays size={14} stroke-width={2.2} />
            Updated {viz.data.updated}
          </span>
          {
            viz.data.datasets.map((d) => (
              <span class="inline-flex items-center gap-1.5">
                <Database size={14} stroke-width={2.2} />
                <code class="font-mono">{d}</code>
              </span>
            ))
          }
        </div>
      </header>
      <Prose>
        <Content />
      </Prose>

      {
        relatedIdeas.length > 0 && (
          <section class="mt-10 rounded-2xl border border-line bg-cream p-6">
            <h3 class="flex items-center gap-2 font-display font-bold text-sm uppercase tracking-wide text-ink mb-3">
              <Link2 size={16} stroke-width={2.4} />
              Ideas building on this
            </h3>
            <ul class="space-y-2">
              {relatedIdeas.map((idea) => (
                <li>
                  <a
                    href={`/next/${idea.id}`}
                    class="font-semibold text-navy hover:text-saffron-600 transition-colors"
                  >
                    {idea.data.title} →
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </Container>
  </article>
</BaseLayout>
