---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { getCollection } from "astro:content";

const ideas = (await getCollection("ideas")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const three = [
  {
    href: "/then",
    label: "Then",
    line: "How we got here",
    text: "A milestone timeline of the republic, 1947–2014: constitution to freight corridors, green revolution to digital foundations.",
  },
  {
    href: "/now",
    label: "Now",
    line: "Where we stand",
    text: "Data visualisations with sources you can check — UPI, Jan Dhan, rail electrification. Every chart starts at 1947 or wherever its data begins.",
  },
  {
    href: "/next",
    label: "Next",
    line: "Where we could go",
    text: "Proposals, tracked honestly: spark, gap, precedent, ask — and a public record of every submission and what came back.",
  },
];
---

<BaseLayout>
  <section class="pt-16 pb-10 md:pt-24">
    <p class="text-xs uppercase tracking-[0.3em] text-ember font-semibold mb-3">
      A journal of progress and possibilities
    </p>
    <h1 class="font-display text-4xl md:text-5xl font-bold text-ink leading-tight max-w-2xl">
      Then. Now. Next.
    </h1>
    <p class="mt-4 text-lg text-ink/70 leading-relaxed max-w-xl">
      India's story in three linked views — what the country has built since
      1947, what the data says about where it stands, and where it could go
      next. Written by one citizen, citable by anyone.
    </p>
  </section>

  <section class="grid md:grid-cols-3 gap-4 pb-12">
    {
      three.map((t) => (
        <a
          href={t.href}
          class="group rounded-xl border border-stone-300 bg-white p-6 hover:border-navy hover:shadow-md transition-all"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="font-display text-2xl font-bold text-ink group-hover:text-navy transition-colors">
              {t.label}
            </span>
            <span class="text-stone-400 group-hover:text-navy transition-colors">→</span>
          </div>
          <p class="text-sm font-semibold text-ink/90 mb-2">{t.line}</p>
          <p class="text-sm text-fog leading-relaxed">{t.text}</p>
        </a>
      ))
    }
  </section>

  <section class="mt-6 mb-14">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="font-display text-xl font-bold text-ink">Latest ideas</h2>
      <a href="/next" class="text-sm text-navy underline underline-offset-2 hover:decoration-navy">
        All ideas →
      </a>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      {
        ideas.slice(0, 4).map((idea) => (
          <a
            href={`/next/${idea.id}`}
            class="rounded-lg border border-stone-300 bg-white p-5 hover:border-navy transition-colors"
          >
            <div class="flex items-center justify-between gap-3 mb-2">
              <StatusBadge status={idea.data.status} />
              <span class="text-xs text-fog">
                {idea.data.themes.slice(0, 2).join(" · ")}
              </span>
            </div>
            <h3 class="font-display font-bold text-ink leading-snug">
              {idea.data.title}
            </h3>
            <p class="mt-1.5 text-sm text-fog line-clamp-2">{idea.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
